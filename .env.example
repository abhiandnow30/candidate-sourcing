APOLLO_API_KEY=your_server_side_apollo_key
PORT=3000
# Only set this if the frontend is served from a different origin.
# Leave empty for same-origin (Vite proxy in dev).
ALLOWED_ORIGIN=

# Required only to search other data sources for an address Apollo does not
# already hold (waterfall enrichment).
#
# This is not a formality. Polling returns only a summary and the person IDs -
# Apollo sends the found addresses themselves in a POST to this URL. Point it at
# a 404 and Apollo still charges for what it found, and you never receive it.
#
# This app serves a receiver at POST /api/apollo/waterfall-webhook, so set this
# to that path on a URL Apollo can reach over HTTPS:
#   deployed:  https://your-host/api/apollo/waterfall-webhook
#   local dev: run a tunnel (cloudflared tunnel --url http://localhost:3000)
#              and use https://<tunnel-host>/api/apollo/waterfall-webhook
APOLLO_WEBHOOK_URL=
